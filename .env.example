# Development-only overrides. The installed app needs none of these: its settings live in config.json.
# Copy to .env (git-ignored); `make dev` loads it. An invalid value stops the app at startup (devenv.invalid).

# Data dir root: config.json, state.json, channels/ (WhatsApp session.db…), logs/, backups/.
# Use a separate folder in dev so the WhatsApp session is a test one, never the installed app's.
# A relative path is resolved against the working directory of the app process.
# Default: %APPDATA%\wchron
WCHRON_DATA_DIR=./.devdata

# debug | info | warn | error. Default: info
WCHRON_LOG_LEVEL=debug

# true skips the update check (any Go boolean: true/false, 1/0). Default: false
WCHRON_UPDATE_DISABLED=true
